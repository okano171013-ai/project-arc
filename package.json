{
  "name": "project-arc",
  "version": "0.9.0",
  "description": "Project ARC — AI Life Management OS (Version9: ARC bridge)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/infrastructure/cli/reflect.ts",
    "morning": "tsx src/infrastructure/cli/morning.ts",
    "reflect": "tsx src/infrastructure/cli/reflect.ts",
    "inventory": "tsx src/infrastructure/cli/inventory.ts",
    "memory": "tsx src/infrastructure/cli/memory.ts",
    "appearance": "tsx src/infrastructure/cli/appearance.ts",
    "skin": "tsx src/infrastructure/cli/skin.ts",
    "purchase": "tsx src/infrastructure/cli/purchase.ts",
    "challenge": "tsx src/infrastructure/cli/challenge.ts",
    "capture": "tsx src/infrastructure/cli/capture.ts",
    "timeline": "tsx src/infrastructure/cli/timeline.ts",
    "evaluation": "tsx src/infrastructure/cli/evaluation.ts",
    "bridge": "tsx src/infrastructure/cli/bridge.ts",
    "api": "tsx src/infrastructure/http/server.ts",
    "find": "tsx src/infrastructure/cli/search.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || exit 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.14.1",
    "googleapis": "^144.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "prettier": "^3.3.2",
    "tsx": "^4.16.2",
    "typescript": "~5.5.4",
    "vitest": "^2.0.3"
  }
}
