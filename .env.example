# Project ARC - Environment Variables
# 実際の値は .env に記載し、コミットしないこと（.gitignore済み）

# Supabase（Version1: supabase CLIのローカルスタック）
# `supabase start` 実行後に表示される値を使用する
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=

# Notion（Version2: pnpm reflect --db=notion で使用）
# NOTION_API_KEY: Notionのintegration作成時に発行されるInternal Integration Secret
# NOTION_DATABASE_ID: Reflection用データベースのID（docs/architecture.md「Notion連携」参照）
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Node環境
NODE_ENV=development

# --- Version2以降で追加予定（今は未使用） ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
