# Project ARC - Environment Variables
# 実際の値は .env に記載し、コミットしないこと（.gitignore済み）

# Supabase（Version1: supabase CLIのローカルスタック）
# `supabase start` 実行後に表示される値を使用する
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=

# Node環境
NODE_ENV=development

# Google Calendar / Tasks 連携（Version3, 任意）
# セットアップ手順: docs/setup/google-api-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Version4以降で追加予定（今は未使用） ---
# NOTION_API_KEY=
