# Project ARC - Environment Variables
# 実際の値は .env に記載し、コミットしないこと（.gitignore済み）

# Supabase（ローカルはsupabase CLI、クラウドはVersion2以降。ADR 0001, 0003）
# `supabase start` 実行後 / クラウドプロジェクトのAPI設定から取得する
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=

# Supabase Auth: 単一Ownerユーザーの認証情報（RLSが有効なため必須。ADR 0003）
# 事前にSupabase Studio（Authentication > Users）でOwner本人のユーザーを
# 作成しておくこと。招待・サインアップ機能は無い（Principle 9）。
SUPABASE_OWNER_EMAIL=
SUPABASE_OWNER_PASSWORD=

# Notion（Version2: pnpm reflect --db=notion で使用）
# NOTION_API_KEY: Notionのintegration作成時に発行されるInternal Integration Secret
# NOTION_DATABASE_ID: Reflection用データベースのID（docs/architecture.md「Notion連携」参照）
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Node環境
NODE_ENV=development

# --- Version2以降で追加予定（今は未使用） ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
