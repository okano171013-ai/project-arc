# Project ARC - Environment Variables
# 実際の値は .env に記載し、コミットしないこと（.gitignore済み）

# Supabase（Version1: supabase CLIのローカルスタック）
# `supabase start` 実行後に表示される値を使用する
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=

# Node環境
NODE_ENV=development

# Google Calendar / Tasks 連携（Version3, 任意）
# セットアップ手順: docs/setup/google-api-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ARC Connector（Version15、任意）
# 設定すると GET /health 以外の全ルートで Authorization: Bearer <key>
# によるAPI Key認証が強制される（未設定なら従来通り認証なし、ADR 0036）。
# Remote MCPサーバー（Version18、pnpm run mcp:remote）の/mcpエンドポイント
# 自体は認証しない（ADR 0044）——この値はConnector→HTTP API間の内部認証にのみ使う。
# セットアップ手順: docs/setup/chatgpt-mcp-connection.md
ARC_API_KEY=
# Connector自身（src/infrastructure/connector/）の接続先。既定値は
# ローカルのARC Connector HTTP API。
ARC_CONNECTOR_BASE_URL=http://127.0.0.1:3939
# Remote MCPサーバー（Version18）の待受ポート。既定3940。
MCP_HTTP_PORT=3940

# Remote MCP OAuth 2.1試作（Version22、任意、既定false）
# trueにするとADR 0044の無認証挙動をやめ、LocalOAuthProviderによる
# Passcodeゲート付きOAuth 2.1フローで/mcpを保護する（ADR 0049）。
# Version22時点では本番未有効化——設定手順はdocs/setup/
# remote-mcp-oauth-migration.mdを参照し、Owner自身の判断で行うこと。
MCP_OAUTH_ENABLED=false
# MCP_OAUTH_ENABLED=trueのときのみ必須。Owner本人だけが知る文字列
# （16文字以上推奨）。他のパスワードと使い回さないこと。
MCP_OAUTH_OWNER_PASSCODE=

# Study Session Ingestion（Version27、任意）
# ARC Study Timerからの学習セッション受信専用API（remoteServer.ts、
# 公開トンネル側）。未設定ならこのエンドポイントは常に401を返す
# （fail-closed、ADR 0054）。ARC_API_KEY・MCP_OAUTH_OWNER_PASSCODEとは
# 別の秘密情報として扱い、使い回さないこと。
STUDY_TIMER_API_TOKEN=
# カンマ区切りの許可オリジン一覧（例：https://timer.example.com）。
# 未設定ならブラウザからのクロスオリジンリクエストは常に拒否される
# （Shortcuts等の非ブラウザクライアントはCORSの対象外なので未設定でも動く）。
STUDY_TIMER_ALLOWED_ORIGINS=

# Mobile Ingress（Version35〜36、任意）
# `pnpm mobile-ingress`が受信サーバーとして待ち受けるport/host。
# MOBILE_INGRESS_HOST既定値は127.0.0.1（外部公開なし）。
# 0.0.0.0等へ変更すると同一LAN内の他デバイスから認証なしで到達可能に
# なる——スマホからの実送信にはこの変更が必要だが、Owner自身の判断で
# 設定すること（ADR 0064「完全ローカル」制約、Version36 Report参照）。
MOBILE_INGRESS_PORT=3941
MOBILE_INGRESS_HOST=127.0.0.1

# --- Version4以降で追加予定（今は未使用） ---
# NOTION_API_KEY=
