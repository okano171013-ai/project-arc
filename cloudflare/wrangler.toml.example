# 参照専用テンプレート — Owner確認前は実行・デプロイしない
# （cloudflare/README.md、ADR 0068・0069参照）。
#
# 実際にデプロイする際は、このファイルを wrangler.toml へリネームし、
# account_id・KV namespace id を Owner自身が設定すること。
# Claude Codeはアカウント作成・デプロイを代行できない
# （Owner指示書2026-07-20で明示的に禁止）。
#
# ローカルのMiniflareテスト（`pnpm cloudflare:test`、
# cloudflare/src/worker.test.ts）はこのファイルを一切使わない
# ——esbuildでworker.tsを直接bundleしてMiniflareへ渡すため、
# wrangler CLI・account_id・ログインは不要。

name = "project-arc-mobile-ingress"
main = "src/worker.ts"
compatibility_date = "2026-07-20"
compatibility_flags = ["nodejs_compat"]  # node:cryptoをUseCase層がそのまま使うため必須

# account_id = ""                # Owner自身のCloudflareアカウントID

[[kv_namespaces]]
binding = "INGRESS_RECORDS"      # worker.tsのEnv.INGRESS_RECORDSと一致させる
# id = ""                        # wrangler kv:namespace create で発行

# secretは`wrangler secret put`で設定する（wrangler.tomlへ平文で書かない）。
#   wrangler secret put DEVICE_TOKEN   # スマホ側token（POST + 自分のstatus確認のみ）
#   wrangler secret put PULL_TOKEN     # PC側pnpm mobile-sync pull専用token（全件list + ack）
