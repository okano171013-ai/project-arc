    "/agent-messages": {
      "get": {
        "operationId": "listAgentMessages",
        "summary": "ARC↔Claude Code間の往復記録を一覧取得する",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "ToClaudeCode",
                "ToARC"
              ]
            },
            "required": false,
            "name": "direction",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "relatedVersion",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
