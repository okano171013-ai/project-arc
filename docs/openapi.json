{
  "openapi": "3.0.0",
  "info": {
    "title": "Project ARC Connector API",
    "version": "1.0.0",
    "description": "ARC（ChatGPT/Claude）が利用する主要エンドポイントのみを対象とするOpenAPI 3.xドキュメント（Version18、指示書6章。operationId/request/responseのみ、Actions実装は対象外）。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3939",
      "description": "ローカル既定値（pnpm run api）。実際の公開URLは環境ごとに異なる"
    }
  ],
  "components": {
    "schemas": {
      "ProposalType": {
        "type": "string",
        "enum": [
          "Reflection",
          "Memory",
          "ExternalKnowledge",
          "Appearance",
          "ManagementFeedback",
          "AgentMessage"
        ]
      },
      "Proposal": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ProposalType"
          },
          "target": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          },
          "reason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target",
          "payload",
          "reason",
          "createdAt"
        ]
      },
      "Resolution": {
        "type": "string",
        "enum": [
          "Open",
          "Accepted",
          "Implemented",
          "Closed",
          "Rejected"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/read/reflection": {
      "get": {
        "operationId": "readReflection",
        "summary": "直近のReflectionを新しい順に最大limit件取得する",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "取得する最大件数（必須）"
            },
            "required": true,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Reflectionの一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "reflections": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": {
                              "nullable": true
                            }
                          }
                        }
                      },
                      "required": [
                        "reflections"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
